   "source": [
    "# take the source that we just found from the fixed-point iteration algorthim and iterate it again with the whitened signal\n",
    "# use this signal to find spikes again, and keep iterating through so long as CoV decrease"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "06ae3600-1e14-4567-bc55-902529953866",
